# Synthetic FASM for the smoke test. Not a dump of any real bitstream: it
# is written by hand against tests/fixtures/db (see make_fixture_db.py) so
# that every cell family the extractor knows about appears exactly once.

# --- the original LUT+FF case, kept byte for byte ---
TESTCLB_X0Y0.SLICEX_X0.ALUT.INIT[63:0] = 64'b1111111111111111111111111111111100000000000000000000000000000000
TESTCLB_X0Y0.SLICEX_X0.FFSYNC
TESTCLB_X0Y0.SLICEX_X0.AFF.ZINI
TESTCLB_X0Y0.SLICEX_X0.AFF.ZRST

# --- SLICEM_X0: a carry chain, its XOR output captured by the A flop ---
TESTCLBM_X0Y1.SLICEM_X0.ALUT.INIT[63:0] = 64'b0110011001100110011001100110011001100110011001100110011001100110
TESTCLBM_X0Y1.SLICEM_X0.BLUT.INIT[63:0] = 64'b0110011001100110011001100110011001100110011001100110011001100110
TESTCLBM_X0Y1.SLICEM_X0.CLUT.INIT[63:0] = 64'b0110011001100110011001100110011001100110011001100110011001100110
TESTCLBM_X0Y1.SLICEM_X0.DLUT.INIT[63:0] = 64'b0110011001100110011001100110011001100110011001100110011001100110
TESTCLBM_X0Y1.SLICEM_X0.PRECYINIT.C0
TESTCLBM_X0Y1.SLICEM_X0.CARRY4.ACY0
TESTCLBM_X0Y1.SLICEM_X0.CARRY4.BCY0
TESTCLBM_X0Y1.SLICEM_X0.AFFMUX.XOR
TESTCLBM_X0Y1.SLICEM_X0.AFF.ZRST
TESTCLBM_X0Y1.SLICEM_X0.BOUTMUX.CY
TESTCLBM_X0Y1.SLICEM_X0.FFSYNC

# --- SLICEM_X1: a 32-deep shift register in D, cascading into C, and a
#     pair of 16-deep ones sharing the A column ---
TESTCLBM_X0Y1.SLICEM_X1.DLUT.INIT[63:0] = 64'b1111001111111100110011001111001111001111111111001111110011111111
TESTCLBM_X0Y1.SLICEM_X1.DLUT.SRL
TESTCLBM_X0Y1.SLICEM_X1.CLUT.INIT[63:0] = 64'b0000000011111111000000001111111100000011000011000000111100110000
TESTCLBM_X0Y1.SLICEM_X1.CLUT.SRL
TESTCLBM_X0Y1.SLICEM_X1.CLUT.DI1MUX.DI_DMC31
TESTCLBM_X0Y1.SLICEM_X1.ALUT.INIT[63:0] = 64'b1100110011001100110011001100110000110011001100110011001100110011
TESTCLBM_X0Y1.SLICEM_X1.ALUT.SRL
TESTCLBM_X0Y1.SLICEM_X1.ALUT.SMALL
TESTCLBM_X0Y1.SLICEM_X1.ALUT.DI1MUX.AI
TESTCLBM_X0Y1.SLICEM_X1.WEMUX.CE

# --- SLICEM_X2: distributed RAM, 64x1 single port in D ---
TESTCLBM_X0Y1.SLICEM_X2.DLUT.INIT[63:0] = 64'b0000000100100011010001010110011110001001101010111100110111101111
TESTCLBM_X0Y1.SLICEM_X2.DLUT.RAM

# --- SLICEM_X3: the wide muxes, F7 pair feeding F8 ---
TESTCLBM_X0Y1.SLICEM_X3.ALUT.INIT[63:0] = 64'b0000000000000000000000000000000011111111111111111111111111111111
TESTCLBM_X0Y1.SLICEM_X3.BLUT.INIT[63:0] = 64'b0000000000000000000000000000000011111111111111111111111111111111
TESTCLBM_X0Y1.SLICEM_X3.CLUT.INIT[63:0] = 64'b0000000000000000000000000000000011111111111111111111111111111111
TESTCLBM_X0Y1.SLICEM_X3.DLUT.INIT[63:0] = 64'b0000000000000000000000000000000011111111111111111111111111111111
TESTCLBM_X0Y1.SLICEM_X3.BOUTMUX.F8

# --- DSP48E1 ---
TESTDSP_X1Y0.DSP48.DSP_0.AREG_0
TESTDSP_X1Y0.DSP48.DSP_0.BREG_0
TESTDSP_X1Y0.DSP48.DSP_0.ZADREG[0]
TESTDSP_X1Y0.DSP48.DSP_0.ZCREG[0]
TESTDSP_X1Y0.DSP48.DSP_0.USE_DPORT
TESTDSP_X1Y0.DSP48.DSP_0.MASK[45:0] = 46'b1111111111111111111111111111111111111111111100
TESTDSP_X1Y0.DSP48.DSP_0.ZIS_OPMODE_INVERTED[0]
TESTDSP_X1Y0.DSP48.DSP_0.ZIS_OPMODE_INVERTED[1]
TESTDSP_X1Y0.DSP48.DSP_0.ZIS_OPMODE_INVERTED[2]
TESTDSP_X1Y0.DSP48.DSP_0.ZIS_OPMODE_INVERTED[3]
TESTDSP_X1Y0.DSP48.DSP_0.ZIS_OPMODE_INVERTED[4]
TESTDSP_X1Y0.DSP48.DSP_0.ZIS_OPMODE_INVERTED[5]
TESTDSP_X1Y0.DSP48.DSP_0.ZIS_OPMODE_INVERTED[6]
TESTDSP_X1Y0.DSP48.DSP_0.ZIS_CLK_INVERTED

# --- BRAM: one tile as two independent 18Kb halves ---
TESTBRAM_X2Y0.RAMB18_Y0.IN_USE
TESTBRAM_X2Y0.RAMB18_Y0.READ_WIDTH_A_9
TESTBRAM_X2Y0.RAMB18_Y0.WRITE_WIDTH_A_9
TESTBRAM_X2Y0.RAMB18_Y0.ZINV_CLKARDCLK
TESTBRAM_X2Y0.RAMB18_Y0.INIT_00[255:0] = 256'b0110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110
TESTBRAM_X2Y0.RAMB18_Y1.IN_USE
TESTBRAM_X2Y0.RAMB18_Y1.DOA_REG
TESTBRAM_X2Y0.RAMB18_Y1.READ_WIDTH_A_18

# --- BRAM: one tile ganged into a single 36Kb block. The pip below is
#     the whole difference: it routes through the 36Kb site. ---
TESTBRAM_X2Y1.BRAM_FIFO36_DIADI0.EXT0
#     The pips below join each control/address signal's two halves,
#     which is what a real 36Kb block's routing does -- the extractor
#     cross-checks them and reports a tile where they disagree.
TESTBRAM_X2Y1.BRAM_FIFO36_ADDRARDADDRU0.BRAM_FIFO36_ADDRARDADDRL0
TESTBRAM_X2Y1.BRAM_FIFO36_ADDRARDADDRU1.BRAM_FIFO36_ADDRARDADDRL1
TESTBRAM_X2Y1.BRAM_FIFO36_ADDRARDADDRU2.BRAM_FIFO36_ADDRARDADDRL2
TESTBRAM_X2Y1.BRAM_FIFO36_ADDRARDADDRU3.BRAM_FIFO36_ADDRARDADDRL3
TESTBRAM_X2Y1.BRAM_FIFO36_ADDRBWRADDRU0.BRAM_FIFO36_ADDRBWRADDRL0
TESTBRAM_X2Y1.BRAM_FIFO36_ADDRBWRADDRU1.BRAM_FIFO36_ADDRBWRADDRL1
TESTBRAM_X2Y1.BRAM_FIFO36_ADDRBWRADDRU2.BRAM_FIFO36_ADDRBWRADDRL2
TESTBRAM_X2Y1.BRAM_FIFO36_ADDRBWRADDRU3.BRAM_FIFO36_ADDRBWRADDRL3
TESTBRAM_X2Y1.BRAM_FIFO36_CLKARDCLKU.BRAM_FIFO36_CLKARDCLKL
TESTBRAM_X2Y1.BRAM_FIFO36_CLKBWRCLKU.BRAM_FIFO36_CLKBWRCLKL
TESTBRAM_X2Y1.BRAM_FIFO36_ENARDENU.BRAM_FIFO36_ENARDENL
TESTBRAM_X2Y1.BRAM_FIFO36_ENBWRENU.BRAM_FIFO36_ENBWRENL
TESTBRAM_X2Y1.BRAM_FIFO36_REGCEAREGCEU.BRAM_FIFO36_REGCEAREGCEL
TESTBRAM_X2Y1.BRAM_FIFO36_REGCEBU.BRAM_FIFO36_REGCEBL
TESTBRAM_X2Y1.BRAM_FIFO36_REGCLKARDRCLKU.BRAM_FIFO36_REGCLKARDRCLKL
TESTBRAM_X2Y1.BRAM_FIFO36_REGCLKBU.BRAM_FIFO36_REGCLKBL
TESTBRAM_X2Y1.BRAM_FIFO36_RSTRAMARSTRAMU.BRAM_FIFO36_RSTRAMARSTRAMLRST
TESTBRAM_X2Y1.BRAM_FIFO36_RSTRAMBU.BRAM_FIFO36_RSTRAMBL
TESTBRAM_X2Y1.BRAM_FIFO36_RSTREGARSTREGU.BRAM_FIFO36_RSTREGARSTREGL
TESTBRAM_X2Y1.BRAM_FIFO36_RSTREGBU.BRAM_FIFO36_RSTREGBL
TESTBRAM_X2Y1.BRAM_FIFO36_WEAU0.BRAM_FIFO36_WEAL0
TESTBRAM_X2Y1.BRAM_FIFO36_WEAU1.BRAM_FIFO36_WEAL1
TESTBRAM_X2Y1.RAMB18_Y0.IN_USE
TESTBRAM_X2Y1.RAMB18_Y0.READ_WIDTH_A_4
TESTBRAM_X2Y1.RAMB18_Y0.WRITE_WIDTH_A_4
TESTBRAM_X2Y1.RAMB18_Y0.INIT_01[255:0] = 256'b1001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001100110011001
TESTBRAM_X2Y1.RAMB18_Y1.IN_USE
