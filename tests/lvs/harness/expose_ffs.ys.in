read_verilog @WORK@/cells_min.v
read_json @WORK@/gold_nobb.json
hierarchy -top top ; proc ; flatten ; splitnets ; opt_clean
expose -dff
rename top gold
write_verilog -noattr @WORK@/gold_exp.v
design -reset

read_verilog @WORK@/cells_min.v @WORK@/johnson_lvs_named.v
hierarchy -top top ; proc ; flatten ; splitnets ; opt_clean
expose -dff
rename top gate
write_verilog -noattr @WORK@/gate_exp.v
