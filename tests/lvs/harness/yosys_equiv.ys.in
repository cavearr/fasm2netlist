read_json @REPO@/examples/vc707-johnson/johnson.json
read_verilog @WORK@/cells_min.v
hierarchy -top top ; splitnets ; prep -top top -flatten ; design -stash gold

read_verilog @WORK@/cells_min.v @WORK@/johnson_lvs_named.v
hierarchy -top top ; splitnets ; prep -top top -flatten ; design -stash gate

design -copy-from gold -as gold top
design -copy-from gate -as gate top
equiv_make gold gate equiv
hierarchy -top equiv
equiv_miter -trigger -cmp -assert miter
hierarchy -top miter
async2sync
hierarchy -top miter
stat
sat -tempinduct -seq 4 -prove trigger 0 -dump_json @WORK@/cex_induct.json -timeout 600
